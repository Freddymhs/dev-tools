# PROJECT_PATH, DOWNLOAD_URL y VIDEO_PATH NO van aquí — el TUI los pide en cada corrida.

# Identificador completo del modelo de Whisper (tamaño y versión vienen juntos
# en este único string, p.ej. "small", "large-v3", "large-v3-turbo", "small.en").
# Opcional — si no se define (ni existe .env.local), el default es "small".
WHISPER_MODEL=small

  ┌────────────────┬────────┬──────────────────────────────────────┬────────────────┐
  │ WHISPER_MODEL  │ Tamaño │       Velocidad estimada (CPU)       │ Tu tiempo real │
  ├────────────────┼────────┼──────────────────────────────────────┼────────────────┤
  │ tiny           │ 73MB   │ ⚡⚡⚡⚡ — más rápido                │                │
  ├────────────────┼────────┼──────────────────────────────────────┼────────────────┤
  │ base           │ 139MB  │ ⚡⚡⚡                               │                │
  ├────────────────┼────────┼──────────────────────────────────────┼────────────────┤
  │ small          │ 462MB  │ ⚡⚡                                 │                │
  ├────────────────┼────────┼──────────────────────────────────────┼────────────────┤
  │ large-v3-turbo │ 1.6GB  │ ⚡ — mejor balance calidad/velocidad │                │
  ├────────────────┼────────┼──────────────────────────────────────┼────────────────┤
  │ large-v3       │ 2.9GB  │ 🐢 — más lento                       │                │
  └────────────────┴────────┴──────────────────────────────────────┴────────────────┘

# Directorio base de salida (opcional, default: ~/Documents/dev-tools)
# DEV_TOOLS_OUTPUT_BASE=/ruta/absoluta/donde/guardar/todo

# Binario de transcripción a usar (opcional, default: whisper)
# Permite reemplazar el motor (faster-whisper, whisper.cpp, etc.) sin tocar
# código, siempre que acepte los mismos flags: --model, --output_format,
# --output_dir y un path de archivo como argumento posicional.
# WHISPER_BIN=whisper
