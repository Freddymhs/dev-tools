# Ruta absoluta al proyecto que quieres escanear
PROJECT_PATH=/ruta/absoluta/al/proyecto

# Ruta absoluta al video que quieres dividir (opcional si usas npm run download)
VIDEO_PATH=/ruta/absoluta/al/video.webm

# URL del video a descargar (YouTube, TikTok, Instagram, Twitter/X, etc.)
DOWNLOAD_URL=https://www.youtube.com/watch?v=EJEMPLO

# Modelo de Whisper para transcripción: tiny | base | small...
WHISPER_MODEL=small

  ┌────────────────┬────────┬──────────────────────────────────────┬────────────────┐                          
  │ WHISPER_MODEL  │ Tamaño │       Velocidad estimada (CPU)       │ Tu tiempo real │                          
  ├────────────────┼────────┼──────────────────────────────────────┼────────────────┤                          
  │ tiny           │ 73MB   │ ⚡⚡⚡⚡ — más rápido                │                │                          
  ├────────────────┼────────┼──────────────────────────────────────┼────────────────┤
  │ base           │ 139MB  │ ⚡⚡⚡                               │                │                          
  ├────────────────┼────────┼──────────────────────────────────────┼────────────────┤
  │ small          │ 462MB  │ ⚡⚡                                 │                │                          
  ├────────────────┼────────┼──────────────────────────────────────┼────────────────┤                          
  │ large-v3-turbo │ 1.6GB  │ ⚡ — mejor balance calidad/velocidad │                │                          
  ├────────────────┼────────┼──────────────────────────────────────┼────────────────┤                          
  │ large-v3       │ 2.9GB  │ 🐢 — más lento                       │                │                          
  └────────────────┴────────┴──────────────────────────────────────┴────────────────┘