{
  "name": "dev-tools",
  "version": "1.0.0",
  "description": "Genera un BUNDLE.md con todo el código fuente de un proyecto — útil para compartir contexto con una IA o trabajar offline.",
  "scripts": {
    "generate": "node generate_bundle.cjs",
    "split": "node split_markdown.cjs",
    "generate-splited": "node generate_bundle.cjs && node split_markdown.cjs && node -e \"const{loadEnv}=require('./lib/env.cjs');loadEnv();const{CODE_RAW}=require('./lib/paths.cjs');require('fs').rmSync(require('path').join(CODE_RAW,'BUNDLE.md'),{force:true})\"",
    "download": "node download_video.cjs",
    "split-video": "node split_video.cjs",
    "transcript": "node transcript_video.cjs",
    "download-splitted": "node download_video.cjs && node split_video.cjs && node transcript_video.cjs",
    "tui": "node tui.cjs",
    "test": "node --test tests/unit/*.test.cjs tests/integration/*.test.cjs",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:integration": "node --test tests/integration/*.test.cjs",
    "test:setup": "bash tests/fixtures/make-videos.sh"
  },
  "keywords": [
    "ai-context",
    "bundle",
    "codebase",
    "offline"
  ],
  "license": "MIT",
  "dependencies": {
    "prompts": "^2.4.2"
  }
}
